<UserControl x:Class="PdfRescue.App.TaskCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="42,32,42,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Task Center" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Follow long-running PDF work without losing the rest of your workspace." Foreground="{StaticResource MutedTextBrush}" FontSize="14" Margin="0,6,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource FlatButtonStyle}" Click="ClearFinished_Click" Padding="13,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"/><TextBlock Text="Clear finished" Margin="7,0,0,0"/></StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="42,0,42,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource PanelCardStyle}" Margin="0,0,8,0" Padding="13"><StackPanel><TextBlock Text="Running" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/><TextBlock x:Name="RunningCount" Text="0" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Margin="0,0,8,0" Padding="13"><StackPanel><TextBlock Text="Queued" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/><TextBlock x:Name="QueuedCount" Text="0" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource PanelCardStyle}" Margin="0,0,8,0" Padding="13"><StackPanel><TextBlock Text="Completed" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/><TextBlock x:Name="CompletedCount" Text="0" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
            <Border Grid.Column="3" Style="{StaticResource PanelCardStyle}" Margin="0,0,8,0" Padding="13"><StackPanel><TextBlock Text="Failed" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/><TextBlock x:Name="FailedCount" Text="0" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
            <Border Grid.Column="4" Style="{StaticResource PanelCardStyle}" Margin="0,0,8,0" Padding="13"><StackPanel><TextBlock Text="Cancelled" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/><TextBlock x:Name="CancelledCount" Text="0" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
            <ComboBox x:Name="FilterCombo" Grid.Column="5" Height="34" VerticalAlignment="Center" SelectionChanged="FilterCombo_SelectionChanged">
                <ComboBoxItem Content="All tasks" />
                <ComboBoxItem Content="Running / queued" />
                <ComboBoxItem Content="Completed" />
                <ComboBoxItem Content="Failed" />
                <ComboBoxItem Content="Cancelled" />
            </ComboBox>
        </Grid>

        <Grid Grid.Row="2" Margin="42,0,42,32">
            <ListBox x:Name="TaskList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,9" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource PanelCardStyle}" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#163251" CornerRadius="9" Padding="8,3" Margin="0,0,9,0"><TextBlock Text="{Binding StateLabel}" Foreground="#7DB7FF" FontSize="11" FontWeight="SemiBold"/></Border>
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Stage}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    <ProgressBar Height="6" Minimum="0" Maximum="1" Value="{Binding Progress}" Margin="0,10,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <TextBlock Text="{Binding ProgressPercent, StringFormat={}{0}%}" Foreground="#7990A7" FontSize="11" />
                                        <TextBlock Text="  •  " Foreground="#53677C" FontSize="11" />
                                        <TextBlock Text="{Binding ElapsedLabel}" Foreground="#7990A7" FontSize="11" />
                                        <TextBlock Text="  •  " Foreground="#53677C" FontSize="11" />
                                        <TextBlock Text="{Binding Type}" Foreground="#7990A7" FontSize="11" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF777D" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource FlatButtonStyle}" Content="Cancel" Click="CancelTask_Click" IsEnabled="{Binding CanCancel}" Margin="18,0,0,0" Padding="12,6" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel x:Name="EmptyTasks" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="38" Foreground="#54708A" HorizontalAlignment="Center" />
                <TextBlock Text="No tasks yet" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                <TextBlock Text="OCR, conversion, compression and other long-running work will appear here." Foreground="{StaticResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,5,0,0" MaxWidth="430" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
