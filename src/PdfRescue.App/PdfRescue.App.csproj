<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\..\assets\asantepdf.ico</ApplicationIcon>
    <AssemblyName>AsantePDF</AssemblyName>
    <RootNamespace>PdfRescue.App</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <PublishSingleFile>false</PublishSingleFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <InformationalVersion>1.0.0-rc10</InformationalVersion>
    <Product>AsantePDF</Product>
    <Title>AsantePDF</Title>
    <Description>Local-first PDF toolkit for Windows</Description>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PDFsharp-WPF" Version="6.2.4" />
    <PackageReference Include="PDFiumCore" Version="153.0.7999" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PdfRescue.Core\PdfRescue.Core.csproj" />
    <ProjectReference Include="..\PdfRescue.Infrastructure\PdfRescue.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Preview\**\*.cs" />
    <Compile Remove="ViewModels\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
