<UserControl x:Class="PdfRescue.App.RecentFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="120">
    <UserControl.Resources>
        <ContextMenu x:Key="RecentContextMenu" x:Shared="False"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Open" Click="OpenMenu_Click" IsEnabled="{Binding Available}" />
            <MenuItem Header="{Binding PinLabel}" Click="PinMenu_Click" />
            <Separator />
            <MenuItem Header="Show in Folder" Click="ShowInFolderMenu_Click" />
            <MenuItem Header="Remove from Recent" Click="RemoveMenu_Click" />
            <MenuItem Header="Remove Missing Entry" Click="RemoveMissingMenu_Click" />
        </ContextMenu>

        <ItemsPanelTemplate x:Key="RecentGridPanel">
            <WrapPanel />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="RecentListPanel">
            <StackPanel />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="RecentCompactPanel">
            <WrapPanel />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="RecentGridTemplate">
            <Button Style="{StaticResource CardLiftButtonStyle}" Click="RecentOpen_Click"
                    ContextMenu="{StaticResource RecentContextMenu}"
                    Width="220" Height="300" Margin="0,0,12,12" Padding="12"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    ToolTip="{Binding Path}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="205" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F5F7FA" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="5" Padding="5">
                        <Grid>
                            <TextBlock Text="PDF" Foreground="#CE3B46" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" Padding="5,2" Background="#D90F1B29" CornerRadius="10">
                                <TextBlock Text="{Binding PinGlyph}" Foreground="{DynamicResource CommandGoldBrush}" FontSize="13" />
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Margin="0,9,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="2" Text="{Binding MetadataLine}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="3" Text="{Binding LastOpenedLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0" VerticalAlignment="Bottom" />
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="RecentListTemplate">
            <Button Style="{StaticResource CardLiftButtonStyle}" Click="RecentOpen_Click"
                    ContextMenu="{StaticResource RecentContextMenu}"
                    Margin="0,0,0,7" Padding="10" HorizontalContentAlignment="Stretch"
                    ToolTip="{Binding Path}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>
                    <Border Width="60" Height="78" Background="#F5F7FA" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="4" Padding="3">
                        <Grid>
                            <TextBlock Text="PDF" Foreground="#CE3B46" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,16,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Location}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding AvailabilityLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding MetadataLine}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextAlignment="Right" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding LastOpenedLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextAlignment="Right" Margin="0,4,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding PinGlyph}" Foreground="{DynamicResource CommandGoldBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="RecentCompactTemplate">
            <Button Style="{StaticResource CardLiftButtonStyle}" Click="RecentOpen_Click"
                    ContextMenu="{StaticResource RecentContextMenu}"
                    Width="300" Height="62" Margin="0,0,8,8" Padding="8"
                    HorizontalContentAlignment="Stretch" ToolTip="{Binding Path}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="26" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="44" Background="#F5F7FA" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="3" Padding="2">
                        <Grid>
                            <TextBlock Text="PDF" Foreground="#CE3B46" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,5,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding PageCountLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding PinGlyph}" Foreground="{DynamicResource CommandGoldBrush}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Recent files" FontSize="19" FontWeight="SemiBold" />
                <TextBlock Text="Real PDF thumbnails, remembered layouts, pinning and recovery state." Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
            <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Button x:Name="ResumeSessionButton" Style="{StaticResource FlatButtonStyle}" Click="ResumeSession_Click" Visibility="Collapsed" Padding="10,6" Margin="0,0,8,0" ToolTip="Restore the document and page position from the last session">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" Foreground="#4D9BFF"/><TextBlock Text="Resume session" Margin="7,0,0,0"/></StackPanel>
                </Button>
                <TextBox x:Name="RecentSearchBox" Width="210" Height="32" TextChanged="RecentSearchBox_TextChanged" ToolTip="Filter recent PDFs" />
                <ComboBox x:Name="SortCombo" Width="125" Height="32" Margin="8,0,0,0" SelectionChanged="SortCombo_SelectionChanged">
                    <ComboBoxItem Content="Last opened" />
                    <ComboBoxItem Content="Name" />
                    <ComboBoxItem Content="Modified" />
                </ComboBox>
                <Button x:Name="GridViewButton" Style="{StaticResource FlatButtonStyle}" Click="GridView_Click" Content="Grid" Padding="8,5" Margin="8,0,0,0" ToolTip="Grid view" />
                <Button x:Name="ListViewButton" Style="{StaticResource FlatButtonStyle}" Click="ListView_Click" Content="List" Padding="8,5" ToolTip="List view" />
                <Button x:Name="CompactViewButton" Style="{StaticResource FlatButtonStyle}" Click="CompactView_Click" Content="Compact" Padding="8,5" ToolTip="Compact view" />
            </WrapPanel>
        </Grid>

        <ItemsControl x:Name="RecentItems" />
        <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,28,0,0">
            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="No matching recent files" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
            <TextBlock Text="Open a PDF and it will appear here automatically." Foreground="{DynamicResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>
    </StackPanel>
</UserControl>