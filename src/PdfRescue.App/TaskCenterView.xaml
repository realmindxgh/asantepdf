<UserControl x:Class="PdfRescue.App.TaskCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="24,22,24,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Task Center" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Follow long-running PDF work without losing the rest of your workspace." Foreground="{DynamicResource MutedTextBrush}" FontSize="14" Margin="0,6,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource FlatButtonStyle}" Click="ClearFinished_Click" Padding="13,7" VerticalAlignment="Center" ToolTip="Remove completed, failed and cancelled tasks from this session">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"/><TextBlock Text="Clear finished" Margin="7,0,0,0"/></StackPanel>
            </Button>
        </Grid>

        <WrapPanel Grid.Row="1" Margin="24,0,24,16">
            <Border Style="{StaticResource PanelCardStyle}" Width="112" Margin="0,0,8,8" Padding="12"><StackPanel><TextBlock Text="Running" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/><TextBlock x:Name="RunningCount" Text="0" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource PanelCardStyle}" Width="112" Margin="0,0,8,8" Padding="12"><StackPanel><TextBlock Text="Queued" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/><TextBlock x:Name="QueuedCount" Text="0" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource PanelCardStyle}" Width="112" Margin="0,0,8,8" Padding="12"><StackPanel><TextBlock Text="Completed" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/><TextBlock x:Name="CompletedCount" Text="0" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource PanelCardStyle}" Width="112" Margin="0,0,8,8" Padding="12"><StackPanel><TextBlock Text="Failed" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/><TextBlock x:Name="FailedCount" Text="0" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource PanelCardStyle}" Width="112" Margin="0,0,8,8" Padding="12"><StackPanel><TextBlock Text="Cancelled" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/><TextBlock x:Name="CancelledCount" Text="0" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
            <ComboBox x:Name="FilterCombo" Width="190" Height="36" Margin="0,8,0,8" VerticalAlignment="Center" SelectionChanged="FilterCombo_SelectionChanged" AutomationProperties.Name="Task Center filter">
                <ComboBoxItem Content="All tasks" /><ComboBoxItem Content="Running / queued" /><ComboBoxItem Content="Completed" /><ComboBoxItem Content="Failed" /><ComboBoxItem Content="Cancelled" />
            </ComboBox>
        </WrapPanel>

        <Grid Grid.Row="2" Margin="24,0,24,24">
            <ListBox x:Name="TaskList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Task Center jobs">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,9" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardLiftBorderStyle}" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border CornerRadius="9" Padding="8,3" Margin="0,0,9,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#163251" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StateLabel}" Value="Completed"><Setter Property="Background" Value="#17351F" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding StateLabel}" Value="Failed"><Setter Property="Background" Value="#3C1B22" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding StateLabel}" Value="Cancelled"><Setter Property="Background" Value="#27313C" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StateLabel}" FontSize="12" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#7DB7FF" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StateLabel}" Value="Completed"><Setter Property="Foreground" Value="#7FE38C" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding StateLabel}" Value="Failed"><Setter Property="Foreground" Value="#FF777D" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding StateLabel}" Value="Cancelled"><Setter Property="Foreground" Value="#B6C0CC" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding SourceLabel, StringFormat=Source: {0}}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourcePath}" />
                                    <TextBlock Text="{Binding Stage}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
                                    <ProgressBar Height="6" Minimum="0" Maximum="1" Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" Margin="0,10,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <TextBlock Text="{Binding ProgressLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                        <TextBlock Text="  •  " Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding ElapsedLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                        <TextBlock Text="  •  " Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding Type}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding OutputName, StringFormat=Output: {0}}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding OutputPath}" />
                                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF777D" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap" />
                                </StackPanel>

                                <WrapPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" Width="122">
                                    <Button Style="{StaticResource FlatButtonStyle}" Content="Result options" Click="OpenOutput_Click"
                                            IsEnabled="{Binding CanOpenOutput}" ToolTip="Open result actions" Padding="10,6" Width="118" />
                                    <Button Style="{StaticResource FlatButtonStyle}" Content="Show folder" Click="ShowFolder_Click"
                                            IsEnabled="{Binding CanShowOutputFolder}" ToolTip="Show generated output in Explorer" Padding="10,6" Width="118" />
                                    <Button Style="{StaticResource FlatButtonStyle}" Content="Error details" Click="ErrorDetails_Click"
                                            IsEnabled="{Binding CanShowErrorDetails}" ToolTip="View and copy failure details" Padding="10,6" Width="118" />
                                    <Button Style="{StaticResource FlatButtonStyle}" Content="Retry" Click="RetryTask_Click"
                                            IsEnabled="{Binding CanRetry}" Padding="10,6" Width="118" />
                                    <Button Style="{StaticResource FlatButtonStyle}" Content="Cancel" Click="CancelTask_Click"
                                            IsEnabled="{Binding CanCancel}" Padding="10,6" Width="118" />
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel x:Name="EmptyTasks" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="38" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="No tasks yet" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                <TextBlock Text="OCR, conversion, compression and other long-running work will appear here." Foreground="{DynamicResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,5,0,0" MaxWidth="430" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
